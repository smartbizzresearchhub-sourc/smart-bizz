rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'g3g2aoFniFW0vHYM6Qs7Kci6CJ32';
    }

    function shortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'organisation', 'interest',
          'message', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'organisation', 'interest',
          'message', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.interest is string
        && request.resource.data.interest.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && shortString(request.resource.data.name, 200)
        && shortString(request.resource.data.email, 200)
        && shortString(request.resource.data.phone, 40)
        && shortString(request.resource.data.organisation, 200)
        && shortString(request.resource.data.interest, 100)
        && shortString(request.resource.data.message, 5000)
        && shortString(request.resource.data.source, 100);

      allow read, delete: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'read', 'replied']
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;
      allow write: if false;
    }
  }
}