# Copy this file to .env and fill in the values.

# Firebase (Firebase console → Project settings → Your apps → Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Site settings (optional — window.SMARTBIZZ_CONFIG in index.html takes priority)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_WEBSITE_URL=
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=
